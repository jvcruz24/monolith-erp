{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "strictNullChecks": true
  },
  "baseUrl": ".",
  "paths": {
    "@repo/ui/components": ["./src/components"],
    "@repo/ui/components/ui": ["./src/components/ui"],
    "@repo/ui/lib": ["./src/lib"],
    "@repo/ui/hooks": ["./src/hooks"],
    "@repo/ui/*": ["./src/*"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
