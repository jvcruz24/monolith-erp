{
  "extends": "@repo/typescript-config/nestjs.json",
  "compilerOptions": {
    "resolvePackageJsonExports": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"]
  }
}
